# ---- Python ----
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# ---- 运行产物（目录保留，内容忽略）----
temp/*
!temp/.gitkeep
output/*
!output/.gitkeep
logs/*
!logs/.gitkeep

# ---- 模型与权重（体积大，不入库）----
model_weights/*
!model_weights/.gitkeep
lora_weights/*
!lora_weights/.gitkeep
*.pth
*.pt
*.safetensors
*.ckpt

# ---- 运行时下载的工具（如界面里一键下载的 FFmpeg）----
tools/

# ---- GFPGAN / facexlib 权重（安装脚本下载，体积大）----
gfpgan/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# ---- 工具缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- 临时媒体 ----
*.log
*.part
*.tmp
